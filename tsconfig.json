{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@root/*": ["src/*"],
      "@users/*": ["src/users/*"],
      "@auth/*": ["src/auth/*"],
      "@upload/*": ["src/upload/*"],
      "@mail/*": ["src/mail/*"],
      "@telegram-integration/*": ["src/telegram-integration/*"],
      "@shared/*": ["src/shared/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@config/*": ["src/config/*"],
      "@presentation/*": ["src/presentation/*"],
      "@application/*": ["src/application/*"],
    },

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "references": [
    { "path": "./src/users" },
    { "path": "./src/auth" },
    { "path": "./src/upload" },
    { "path": "./src/likes" },
    { "path": "./src/sample-assets" },
    { "path": "./src/sample-pack" },
    { "path": "./src/search" },
    { "path": "./src/telegram-integration" },
    { "path": "./src/mail" },
  ]
}

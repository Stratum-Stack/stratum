# ================================================================================
# SOUNDR Backend Configuration
# ================================================================================
# Architecture: DDD Bounded Contexts
# - Auth BC: Authentication and authorization
# - Users BC: User management and profiles
# - Upload BC: File storage and S3 management
# - Settings BC: Application configuration
# Each BC has its own infrastructure (models, repos, adapters, factories)
# ================================================================================

# ================================================================================
# Application Configuration
# ================================================================================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_BASE_URL=http://localhost:3000

# ================================================================================
# Database Configuration (MongoDB)
# ================================================================================
# Used by: All Bounded Contexts
# Collections: users, uploads, settings, auth_tokens, etc.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=soundr

# ================================================================================
# Redis Configuration (Event Bus & Cache)
# ================================================================================
# Used for:
# - Event Bus: Inter-service communication between BCs
# - Cache: Session storage, temporary data
# - Workers: Background job queue
REDIS_URI=redis://localhost:6379

# ================================================================================
# Authentication Configuration (Auth BC)
# ================================================================================
# JWT token configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ================================================================================
# S3 / Object Storage Configuration (Upload BC)
# ================================================================================
# For production: Use AWS S3, DigitalOcean Spaces, or similar
# For development: Use MinIO (docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001")

S3_REGION=us-east-1
S3_BUCKET=soundr-uploads

# AWS S3 credentials (or MinIO for local dev)
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# MinIO endpoint (for local development)
# Leave empty for AWS S3
S3_ENDPOINT=http://localhost:9000

# Set to 'true' for MinIO/path-style access, 'false' for AWS S3
S3_FORCE_PATH_STYLE=true

# Public URL for accessing uploaded files
# Example: https://cdn.soundr.ru or http://localhost:9000/soundr-uploads
S3_PUBLIC_BASE_URL=http://localhost:9000/soundr-uploads

# Base path prefix for all uploads (optional)
S3_BASE_PATH=uploads

# ================================================================================
# Telegram Bot Configuration
# ================================================================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ================================================================================
# Email Configuration (SMTP)
# ================================================================================
# Used for notifications and transactional emails
# For development: Use Mailtrap (https://mailtrap.io)
# For production: Use SendGrid, AWS SES, Mailgun, etc.

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@soundr.ru

# ================================================================================
# Logging Configuration
# ================================================================================
# Available levels: error, warn, info, http, verbose, debug
# Development: Use 'debug' for detailed logs
# Production: Use 'info' or 'warn'
LOG_LEVEL=debug

# ================================================================================
# CORS Configuration
# ================================================================================
# Comma-separated list of allowed origins
# Development: Include localhost ports
# Production: Only production domains
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ================================================================================
# Development Tools
# ================================================================================

# MongoDB Admin (optional)
# docker run -p 8081:8081 -e ME_CONFIG_MONGODB_URL="mongodb://localhost:27017" mongo-express
# MONGO_EXPRESS_URL=http://localhost:8081

# Redis Commander (optional)
# docker run -p 8082:8081 -e REDIS_HOSTS=local:localhost:6379 rediscommander/redis-commander
# REDIS_COMMANDER_URL=http://localhost:8082

# MinIO Console (optional)
# Access MinIO web UI at http://localhost:9001
# MINIO_CONSOLE_URL=http://localhost:9001

# ================================================================================
# Production Settings (Override in .env.production)
# ================================================================================

# For production, override these:
# NODE_ENV=production
# LOG_LEVEL=info
# S3_ENDPOINT= (leave empty for AWS S3)
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com
# CORS_ORIGIN=https://yourdomain.com
# API_BASE_URL=https://api.yourdomain.com

# ================================================================================
# Notes
# ================================================================================

# 1. Never commit .env files to git!
# 2. Use strong, random values for JWT_SECRET in production
# 3. Use environment-specific S3 buckets (dev, staging, prod)
# 4. Enable S3 bucket versioning in production
# 5. Configure S3 lifecycle rules to manage storage costs
# 6. Use Redis persistence (AOF or RDB) in production
# 7. Set up MongoDB replica set for production
# 8. Use SSL/TLS for all external connections in production

# ================================================================================
# Quick Start (Local Development)
# ================================================================================

# 1. Install dependencies:
#    bun install

# 2. Start infrastructure:
#    docker-compose -f docker-compose.dev.yml up -d mongo redis minio

# 3. Copy this file:
#    cp .env.example .env

# 4. Update credentials in .env

# 5. Start development server:
#    bun --hot src/presentation/http/server.ts

# 6. Start Telegram bot (optional):
#    bun src/presentation/telegram/bot.ts

# 7. Start workers (optional):
#    bun src/workers/telegram-bot.worker.ts
# S3 / MinIO (local)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
S3_BASE_PATH=
# Database Configuration
MONGODB_URI=
MONGODB_DATABASE=


# Application Configuration
PORT=3000
NODE_ENV=development
HOST=localhost
API_BASE_URL=http://localhost:3000

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Logging Configuration
# Available levels: error, warn, info, http, verbose, debug
# Development: Use 'debug' for detailed logs with emojis
# Production: Use 'info' or 'warn'
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Redis Configuration
REDIS_URI=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=

# Mail Configuration (SMTP для отправки)
# Для разработки используйте Mailtrap (https://mailtrap.io):
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@example.com

# Mail Configuration (IMAP для получения)
IMAP_HOST=mail.hosting.reg.ru
IMAP_PORT=993
IMAP_USER=team@soundr.ru
IMAP_PASSWORD=your-imap-password
IMAP_SECURE=true
